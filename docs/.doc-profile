harness_version = 8
schema_version = 1
mode = leaf
index_file = AGENTS.md
harness_file = CLAUDE.md
inventory_ignore =
index_max_lines = 200
# No single repo-level build/smoke command exists: the engine and the app are
# checked separately (`cd engine && make lint`, `cd engine && pytest`,
# `cd app && npm run typecheck`). The `build` key is deliberately omitted
# rather than invented.
