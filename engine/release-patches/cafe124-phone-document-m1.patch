+"""Phone document and hosted voice startup integration regressions."""
+
+import asyncio
+import importlib
+import os
+from types import SimpleNamespace
+
+import pytest
+from click.testing import CliRunner
+from cryptography.fernet import Fernet
+
+from .test_company_notes import SOURCE, output, provider, save, setup
+from zylch.services import operator_instructions, project_store
+from zylch.services.voice import company_notes as notes
+
+
+def test_missing_phone_refuses_legacy_profile_notes(tmp_path, monkeypatch):
+    profile, snapshot = setup(tmp_path, monkeypatch)
+    with project_store.connection(write=True) as (conn, _):
+        conn.execute(project_store.D.delete())
+        conn.execute(project_store.R.delete())
+    with (profile / ".env").open("a") as stream:
+        stream.write(f"USER_NOTES={SOURCE}\n")
+    calls, _ = provider(monkeypatch, output())
+    assert operator_instructions.phone_source() is None
+    assert notes.current_company_notes(profile, snapshot).status == "unavailable"
+    assert asyncio.run(notes.prepare_company_notes(profile, snapshot)).status == "unavailable"
+    assert calls == []
+
+
+def test_wrong_company_space_refuses_existing_artifact(tmp_path, monkeypatch):
+    profile, snapshot = setup(tmp_path, monkeypatch)
+    calls, _ = provider(monkeypatch, output())
+    assert asyncio.run(notes.prepare_company_notes(profile, snapshot)).status == "supported"
+    snapshot.binding.space_id = "another-space"
+    assert notes.current_company_notes(profile, snapshot).status == "unavailable"
+    assert asyncio.run(notes.prepare_company_notes(profile, snapshot)).status == "unavailable"
+    assert len(calls) == 1
+
+
+def test_same_content_later_revision_invalidates_artifact(tmp_path, monkeypatch):
+    profile, snapshot = setup(tmp_path, monkeypatch)
+    calls, _ = provider(monkeypatch, output())
+    before = asyncio.run(notes.prepare_company_notes(profile, snapshot))
+    save(profile, SOURCE + " Temporary revision.")
+    save(profile, SOURCE)
+    assert operator_instructions.phone_source() == (SOURCE, 3)
+    assert notes.current_company_notes(profile, snapshot).status == "unavailable"
+    after = asyncio.run(notes.prepare_company_notes(profile, snapshot))
+    assert before.status == after.status == "supported"
+    assert before.source_hash == after.source_hash
+    assert before.cache_key != after.cache_key
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize("unit_key_kind", ["valid", "missing", "wrong"])
+def test_voice_serve_preserves_hosted_encryption_gate(tmp_path, monkeypatch, unit_key_kind):
+    from zylch import runtime
+    from zylch.cli import profiles, utils
+    from zylch.config import settings
+    from zylch.rpc import server_ws
+    from zylch.services.voice import listener, production_config
+    from zylch.storage.storage import Storage
+    from zylch.utils import encryption
+
+    main = importlib.import_module("zylch.cli.main")
+    good = Fernet.generate_key().decode()
+    profile_key = Fernet.generate_key().decode()
+    unit_key = good if unit_key_kind == "valid" else Fernet.generate_key().decode()
+    if unit_key_kind == "missing":
+        monkeypatch.delenv("ENCRYPTION_KEY", raising=False)
+    else:
+        monkeypatch.setenv("ENCRYPTION_KEY", unit_key)
+    monkeypatch.setattr(runtime, "_serving", False)
+    monkeypatch.setattr(main, "_check_update", lambda: None)
+    monkeypatch.setattr(main, "_configure_logging", lambda: None)
+    monkeypatch.setattr(main, "_setup_log_file", lambda: None)
+    monkeypatch.setattr(main.atexit, "register", lambda callback: None)
+    monkeypatch.setattr(profiles, "migrate_legacy_profile", lambda: None)
+    monkeypatch.setattr(profiles, "select_profile", lambda name: name)
+    monkeypatch.setattr(profiles, "acquire_lock", lambda name: True)
+    monkeypatch.setattr(profiles, "get_profile_dir", lambda name: str(tmp_path / name))
+
+    def activate(name):
+        assert runtime.is_serving()
+        monkeypatch.setenv("OWNER_ID", name)
+        monkeypatch.setenv("ENCRYPTION_KEY", profile_key)
+
+    monkeypatch.setattr(profiles, "activate_profile", activate)
+    monkeypatch.setattr(utils, "load_env", lambda: monkeypatch.setenv("ENCRYPTION_KEY", profile_key))
+    token = Fernet(good.encode()).encrypt(b"synthetic credential").decode()
+    monkeypatch.setattr(Storage, "get_instance", lambda: SimpleNamespace(
+        list_oauth_token_rows=lambda: [{"credentials": token}]
+    ))
+    config = SimpleNamespace(owner_uid="synthetic-uid", business_id="business-test",
+                             test_number="+390250552776", firebase_web_api_key=SimpleNamespace(
+                                 get_secret_value=lambda: "synthetic-key"))
+    monkeypatch.setattr(production_config, "load_production_config", lambda *args: config)
+    monkeypatch.setattr(settings, "firebase_web_api_key", "previous")
+    for key in ("VOICE_PRODUCTION_OWNER_UID", "VOICE_PRODUCTION_BUSINESS_ID", "VOICE_PRODUCTION_NUMBER"):
+        monkeypatch.setenv(key, "previous")
+    sentinel = object()
+    listeners = []
+
+    def voice_listener(actual, port):
+        assert actual is config and port == 8787
+        assert os.environ["ENCRYPTION_KEY"] == good
+        assert os.environ["VOICE_PRODUCTION_OWNER_UID"] == config.owner_uid
+        listeners.append(actual)
+        return sentinel
+
+    monkeypatch.setattr(listener, "voice_listener", voice_listener)
+    served = []
+
+    async def serve_ws(**kwargs):
+        served.append(kwargs)
+
+    monkeypatch.setattr(server_ws, "serve_ws", serve_ws)
+    path = tmp_path / "voice.env"
+    path.write_text("synthetic configuration")
+    encryption.reset_for_tests()
+    try:
+        result = CliRunner().invoke(main.cli, ["-p", config.owner_uid, "serve", "--unix",
+                                              str(tmp_path / "rpc.sock"), "--voice-config", str(path)])
+        assert result.exit_code == (0 if unit_key_kind == "valid" else 3), result.output
+        assert runtime.is_serving()
+        if unit_key_kind == "valid":
+            assert listeners == [config]
+            assert served == [{"unix_path": str(tmp_path / "rpc.sock"), "voice_listener": sentinel}]
+        else:
+            assert "encryption self-check failed" in result.output
+            assert not listeners and not served
+    finally:
+        encryption.reset_for_tests()
