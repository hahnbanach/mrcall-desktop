# Cross-machine WS backend (mrcall-desktop) — Caddy site config.
#
# desktop.mrcall.ai → the per-profile zylch engines on this VPS. The desktop
# app connects to wss://desktop.mrcall.ai/ws/<uid>; Caddy auto-provisions a
# Let's Encrypt cert (DNS-only A record → this VPS), terminates TLS,
# transparently upgrades the WebSocket, and forwards the
# `Authorization: Bearer <jwt>` header to the engine, which enforces
# `token.uid == OWNER_ID`.
#
# Multi-profile routing: each profile's daemon (zylch-server@<uid>, run by the
# `mc-<hash>` tenant user since plan M2) listens on its own Unix socket,
# reachable as /run/mrcalld/<uid>.sock (a symlink to <uid>/ws.sock once migrated).
# The uid captured from the path selects the socket, so every user shares this
# one URL — no per-user port. A uid with no running daemon → 502 (nothing
# exposed). Security is the per-daemon JWT gate (token.uid == OWNER_ID); a
# mis-route just fails 403, so routing is a hint, not the boundary.
#
# This file is STATIC: adding/removing profiles never changes it (the socket
# path is computed from the uid at request time). See
# docs/execution-plans/multi-profile-routing.md.
#
# /api/provision* routes to provisiond (engine/zylch/provisiond/), the
# singleton vendor-side provisioning + status service — ONE fixed socket,
# not a per-uid one, so this matcher needs no path-derived variable and
# stays exactly as static as the /ws/<uid> rule above: adding/removing
# profiles never touches this file either way. See
# engine/scripts/server/README-provisiond.md.

desktop.mrcall.ai {
	# One static upstream for both layouts. Unmigrated daemons bind the flat
	# /run/mrcalld/<uid>.sock; a migrated one (plan M2) binds
	# /run/mrcalld/<uid>/ws.sock and its tmpfiles fragment (written by
	# `mrcall-tenant create`) makes the flat name a symlink to it. Do NOT
	# route with lb failover here: passive health state is keyed by the
	# templated upstream, so it is shared by every uid, and one request for
	# a missing uid 503'd every customer (scratch VM probe 2026-09-30).
	@ws path_regexp uid ^/ws/([^/]+)$
	reverse_proxy @ws unix//run/mrcalld/{re.uid.1}.sock

	@provision path /api/provision*
	reverse_proxy @provision unix//run/mrcalld/provisiond.sock
}
