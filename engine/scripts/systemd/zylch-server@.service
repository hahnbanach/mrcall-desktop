[Unit]
# Cross-machine WebSocket engine, one instance per profile (%i = Firebase uid).
#
# TRANSITIONAL TEMPLATE (plan M2 of docs/execution-plans/2026-09-29-toward-sandbox.md).
# Unchanged for an instance that has NOT been migrated: it still runs as the
# `mrcalld` service user with the shared key and the flat socket, exactly as
# before. A migrated instance carries a per-instance drop-in written by
# `mrcall-tenant create <uid>` (zylch-server@<uid>.service.d/tenant.conf)
# that overrides User=/Group=, the key file, the data-root environment, the
# socket path and adds the whole sandbox. So the reconcile automation can
# pull this file at any time without touching a running customer; only the
# operator's explicit `create` migrates a profile. Once every profile is
# migrated the drop-in's content is folded into this template.
#   sudo systemctl enable --now zylch-server@<uid>
Description=mrcall-desktop cross-machine WS engine (profile %i)
After=network-online.target
Wants=network-online.target
# Don't crash-loop forever on a misconfigured profile (e.g. one with no
# OWNER_ID makes the engine exit non-zero): give up after 5 starts in 60s.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mrcalld
Group=mrcalld
Environment=HOME=/home/mrcalld
# Shared at-rest key (ENCRYPTION_KEY, Fernet) for the stored OAuth / Firebase
# refresh tokens of UNMIGRATED profiles. The `-` makes it non-fatal if absent.
# A migrated instance's drop-in resets this to its own root-only key file.
EnvironmentFile=-/etc/mrcalld/env
WorkingDirectory=/home/mrcalld
# Unmigrated socket: /run/mrcalld/<uid>.sock in the setgid `caddy` dir
# (engine/scripts/tmpfiles.d/mrcalld.conf); UMask=0007 + chmod(0o660) in
# server_ws.py let the Caddy reverse-proxy connect.
UMask=0007
ExecStart=/home/mrcalld/mrcall-desktop/engine/venv/bin/zylch -p %i serve --unix /run/mrcalld/%i.sock
ExecStopPost=/bin/rm -f /run/mrcalld/%i.sock
Restart=on-failure
RestartSec=3
# Engine logs INFO/DEBUG to the profile's zylch.log; only WARNING+
# reaches journald (journalctl -u zylch-server@%i).

[Install]
WantedBy=multi-user.target
