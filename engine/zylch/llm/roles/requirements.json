{
  "about": "Requirements the resolver (engine/scripts/resolve_models.py, zylch/llm/roles/resolver.py) turns into the snapshot (snapshot.json: every catalogue model's price and request metadata) and, once measured.json covers every role, the decision record (table.json): roles declare a rule and an index, never a model and never a typed floor (thresholds come from measured.json). Prices are USD per million tokens; a preset ceiling bounds the catalogue output price of every ranked model. reference is the measurement's reference model (brief D7). The allowlist and mrcall_served are milestone 10a's, kept only for its readers until the switch-over; the resolver ignores them.",
  "common": {
    "tools": true,
    "min_context": 200000,
    "excluded_variants": [
      ":free",
      ":batch"
    ],
    "required_scores": [
      "intelligence"
    ]
  },
  "presets": {
    "economy": {
      "ceiling": 10
    },
    "balanced": {
      "ceiling": 20
    }
  },
  "_about_policy": "Resolver v2 (milestone 10): excluded_families are matched as a vendor (the part of a catalogue id, canonical_slug or alias target before the first '/') plus a token contained in the part after it; margin multiplies a model's reference price (the snapshot's pricing: the model-level catalogue price whenever an eligible endpoint is priced within it x margin, else the lower median of its eligible endpoints by Artificial Analysis's blended price) into OpenRouter's max_price and the reservation, and bounds the endpoints admitted; provider_policy.quantizations admits endpoints by declared quantization (one that declares none is 'unknown'); excluded_endpoint_variants are service tiers never admitted (a segment of the endpoint tag after the provider).",
  "excluded_families": [
    {
      "vendor": "anthropic",
      "token": "haiku"
    }
  ],
  "margin": 1.25,
  "provider_policy": {
    "quantizations": [
      "int8",
      "fp8",
      "mxfp8",
      "fp16",
      "bf16",
      "fp32",
      "unknown"
    ]
  },
  "excluded_endpoint_variants": [
    "flex"
  ],
  "_about_reference": "The reference of every role's measurement: the production model, run by its adapter (K3 at max effort); every role's bootstrap arms include it.",
